.program hc595
.side_set 1 ; Reloj de desplazamiento (Pin 11)

; Este programa es MSB First para coincidir con tu prueba de bit-banging
.wrap_target
    pull block          side 0  ; Espera 16 bits de la CPU. Reloj LOW.
    set pins, 0         side 0  ; Pin de LATCH (Pin 12) a LOW.
    set x, 15           side 0  [3] ; Delay para t_su del Latch 
    
bitloop:
    out pins, 1         side 0  [3] ; Saca bit a DATA (Pin 14). Espera para t_su 
    jmp x-- bitloop     side 1  [3] ; Sube Reloj. Mantiene HIGH para t_w 
                                    ; Al volver, el side-set pone el reloj en LOW.
    
    set pins, 1         side 0  [3] ; Sube LATCH. Los datos pasan a las salidas Q [cite: 170]
    nop                 side 0  [3] ; Mantiene LATCH HIGH para asegurar la carga 
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void hc595_program_init(PIO pio, uint sm, uint pin_data, uint pin_clk, uint pin_latch) {
    // Configuramos los 3 pines como salidas
    pio_gpio_init(pio, pin_data);
    pio_gpio_init(pio, pin_clk);
    pio_gpio_init(pio, pin_latch);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_data, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_clk, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_latch, 1, true);

    pio_sm_config c = hc595_program_get_default_config(0);
    sm_config_set_out_pins(&c, pin_data, 1);     // DATA (Pin 14) [cite: 161]
    sm_config_set_sideset_pins(&c, pin_clk);      // CLK (Pin 11) [cite: 164]
    sm_config_set_set_pins(&c, pin_latch, 1);    // LATCH (Pin 12) [cite: 169]
    
    // Shift Left (MSB primero) para que coincida con el bit-banging
    sm_config_set_out_shift(&c, false, false, 32);

    // Bajamos la frecuencia a 1 MHz (1 microsegundo por ciclo).
    // Esto es ridículamente lento para el HC595, pero asegura que el 
    // cableado no sea un problema. [cite: 134]
    float div = (float)clock_get_hz(clk_sys) / 1000000;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, 0, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}