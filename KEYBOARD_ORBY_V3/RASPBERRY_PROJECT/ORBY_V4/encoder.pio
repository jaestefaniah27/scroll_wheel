.program encoder
.origin 0

; --- TABLA DE ESTADOS ---
; Estado 00
    jmp update      
    jmp decrement   
    jmp increment   
    jmp update      
; Estado 01
    jmp increment   
    jmp update      
    jmp update      
    jmp decrement   
; Estado 10
    jmp decrement   
    jmp update      
    jmp update      
    jmp increment   
; Estado 11
    jmp update      
    jmp increment   
    jmp decrement   
    jmp update      

; --- MAGIA ARITMÉTICA (APROVECHANDO EL SILICIO) ---
increment:
    mov y, ~y               ; Invertimos Y
    jmp y--, increment_cont ; Salta y resta 1 (si era 0, no salta pero resta igual)
increment_cont:
    mov y, ~y               ; Volvemos a invertir
    jmp push_y              

decrement:
    jmp y--, push_y         ; EL SECRETO: y-- resta SIEMPRE, salte o no salte.
                            ; Si Y es 0, cae a la siguiente línea, pero Y ya vale -1.

push_y:
    mov isr, y          
    push noblock            

.wrap_target
update:
    mov isr, null       
    in x, 2             
    in pins, 2          
    mov x, isr          
    mov pc, isr         
.wrap

; --- RUTINAS EN C PARA EL SDK ---
% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

static inline void encoder_program_init(PIO pio, uint sm, uint pin) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 2, false);
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);
    gpio_pull_up(pin);
    gpio_pull_up(pin + 1);

    pio_sm_config c = encoder_program_get_default_config(0);
    sm_config_set_in_pins(&c, pin);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    float div = (float)clock_get_hz(clk_sys) / 1000000;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, 0, &c);
    pio_sm_exec(pio, sm, pio_encode_set(pio_x, 0)); 
    pio_sm_exec(pio, sm, pio_encode_set(pio_y, 0)); 
    pio_sm_set_enabled(pio, sm, true);
}

static inline int encoder_get_count(PIO pio, uint sm, int current_count) {
    int count = current_count;
    while (!pio_sm_is_rx_fifo_empty(pio, sm)) {
        count = (int)pio_sm_get(pio, sm);
    }
    return count;
}
%}