{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbyGUI",
  "version": "1.0.0-alpha",
  "identifier": "com.orby.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OrbyGUI - Panel de control Orby V4",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#0a0a0f",
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jaestefaniah27/scroll_wheel/releases/latest/download/latest.json"
      ],
      "pubkey": "PEGAR-AQUI-LA-CLAVE-PUBLICA-DE-npm-run-tauri-signer-generate",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
