{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbyGUI",
  "version": "0.5.1",
  "identifier": "com.orby.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OrbyGUI - Panel de control Orby V4",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#0a0a0f",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
